# Template for .env (which is gitignored — copy this file to .env and fill in real values).
# Loaded automatically by common/env.py the first time agents/llm_client.py is imported.

# --- Required: at least one provider key, matching LLM_PROVIDER below ---
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Optional: which provider agents/llm_client.py uses by default ---
# One of: groq | gemini
LLM_PROVIDER=groq

# --- Optional: override the default model per provider ---
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
