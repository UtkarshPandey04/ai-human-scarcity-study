# Template for .env (which is gitignored — copy this file to .env and fill in real values).
# Loaded automatically by common/env.py the first time agents/llm_client.py is imported.

# --- Recommended Primary Key Pools (Comma-Separated, 3-4 keys each for round-robin auto-rotation on 429s) ---
# Multi-key pools prevent single-account free-tier exhaustion and rate limiting.
GROQ_API_KEYS=key1,key2,key3,key4
GEMINI_API_KEYS=key1,key2,key3,key4
OPENROUTER_API_KEYS=key1,key2

# Legacy single-key or comma-separated fallback names (also supported if *_KEYS is unset):
# GROQ_API_KEY=key1
# GEMINI_API_KEY=key1
# OPENROUTER_API_KEY=key1

# --- Optional Local Ollama Runner (Zero cost, high latency fallback) ---
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2
# OLLAMA_API_KEY=ollama

# --- Provider routing mode ---
# One of: heterogeneous | groq | gemini | openrouter | ollama
# 'heterogeneous' distributes co-players across Groq, OpenRouter, Gemini, and Ollama to prevent single-provider bottlenecking.
LLM_PROVIDER=heterogeneous

# --- Optional: override the default model per provider ---
# GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_MODEL=gemini-3.6-flash
# OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
# OLLAMA_MODEL=llama3.2

