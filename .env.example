# Template for .env (which is gitignored — copy this file to .env and fill in real values).
# Loaded automatically by common/env.py the first time agents/llm_client.py is imported.

# --- Primary Providers (Single Key or Comma-Separated Key Pool for Auto-Rotation) ---
GROQ_API_KEY=
# GROQ_API_KEYS=key1,key2,key3
GEMINI_API_KEY=
# GEMINI_API_KEYS=key1,key2

# --- Optional Additional Local / Free-Tier Providers ---
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2
# OLLAMA_API_KEY=
# OPENROUTER_API_KEY=

# --- Provider routing mode ---
# One of: groq | gemini | ollama | openrouter | heterogeneous
# 'heterogeneous' distributes different agents across Groq, Gemini, Ollama, etc. to prevent single-key rate limits.
LLM_PROVIDER=groq

# --- Optional: override the default model per provider ---
# GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_MODEL=gemini-3.6-flash
# OLLAMA_MODEL=llama3.2
# OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
